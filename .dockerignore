# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Django stuff:
*.log
local_settings.py
media/
staticfiles/
static_root/

# Environments (env files can hold secrets: never bake them into the image)
.env
.env.*
.venv
env/
venv/
ENV/
horillavenv/

# IDEs
.vscode/
.idea/
*.swp

# MacOS
.DS_Store

# Node
node_modules/

# Git / CI (not needed in image)
.git
.gitignore
.github/
.gitattributes

# Docker (avoid recursive copy)
docker-compose*.yml
docker-compose*.yaml
Dockerfile
.dockerignore
Makefile
*.log

# Database files
*.sqlite3
TestDB.sqlite3

# Backup artifacts
csv_tmp/
*.dump

# Documentation (not needed in image)
ARCHITECTURE_DIAGRAM.md
CODEBASE_INDEX.md
*.md
!docker/README.md

# SCSS sources — compiled CSS lives under static/build and static/css.
# Only the SCSS is excluded: static/src/js (componentForm.js, custom*Scripts.js,
# ...) and static/src/css are served at runtime, and excluding the whole of
# static/src/ made those files 404 in the image.
static/src/scss/

# Mobile / local-only (not needed in Django image)
flutter_app/
docs/
pg_backup/

# Scratch files from local debugging
_tmp_*
*.err
*.pyc

# Claude/AI / local tooling
.claude/
.cursor/
agent-transcripts/
docker/test-apt.sh
